{
  "expo": {
    "name": "MatchKar",
    "slug": "matchkar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF4458"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matchkar.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "MatchKar needs your location to show nearby people and calculate distance.",
        "NSCameraUsageDescription": "MatchKar needs camera access to take profile photos.",
        "NSPhotoLibraryUsageDescription": "MatchKar needs photo library access to upload profile photos.",
        "NSPhotoLibraryAddUsageDescription": "MatchKar needs permission to save photos to your library.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleSignIn": {
          "reservedClientId": "your-reversed-client-id"
        }
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": ["applinks:matchkar.com"]
    },
    "android": {
      "package": "com.matchkar.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FF4458",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-location",
      "expo-image-picker"
    ],
    "extra": {
      "eas": {
        "projectId": "your-eas-project-id"
      }
    }
  }
}
